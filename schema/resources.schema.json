{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Language Resource Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "catalog_version",
    "updated_on",
    "title",
    "description",
    "resource_count",
    "access_modes",
    "categories",
    "resources"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.5.0"
    },
    "catalog_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "updated_on": {
      "type": "string",
      "format": "date"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "resource_count": {
      "type": "integer",
      "minimum": 0
    },
    "access_modes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    }
  },
  "$defs": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "category",
        "entry_type",
        "language_scope",
        "language_codes",
        "data_type",
        "description",
        "access_mode",
        "access_notes",
        "license_note",
        "limitations",
        "source_url",
        "additional_urls",
        "tags",
        "related_ids",
        "verification",
        "platforms",
        "osf_ids",
        "data_status",
        "data_origin"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^R[0-9]{3,}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "child-language",
            "spoken-variation",
            "social-interaction",
            "lexical-cognition",
            "chinese-l2-bilingual",
            "crossling-cultural",
            "sign-figurative",
            "diachronic-parallel-syntax",
            "syntax",
            "morphology",
            "speech-phonetics",
            "reading-neuro",
            "resource-portals",
            "clinical-language"
          ]
        },
        "entry_type": {
          "enum": [
            "dataset",
            "collection",
            "aggregate",
            "alignment",
            "derived"
          ]
        },
        "language_scope": {
          "type": "string",
          "minLength": 1
        },
        "language_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "data_type": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "access_mode": {
          "enum": [
            "open_data",
            "free_registration",
            "application_required",
            "mixed_access",
            "license_review"
          ]
        },
        "access_notes": {
          "type": "string",
          "minLength": 1
        },
        "license_note": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "additional_urls": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "uniqueItems": true
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "related_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^R[0-9]{3,}$"
          },
          "uniqueItems": true
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "documentation_checked_on",
            "scope",
            "download_tested",
            "data_files_validated",
            "evidence_type",
            "evidence_urls",
            "note"
          ],
          "properties": {
            "documentation_checked_on": {
              "type": "string",
              "format": "date"
            },
            "scope": {
              "enum": [
                "resource_description_and_access_documentation",
                "resource_documentation_and_selected_file_checks"
              ]
            },
            "download_tested": {
              "type": "boolean"
            },
            "data_files_validated": {
              "type": "boolean"
            },
            "evidence_type": {
              "enum": [
                "documentation_reviewed",
                "project_documentation",
                "publisher_data_statement",
                "publisher_resource_description",
                "repository_documentation",
                "indexed_project_wiki"
              ]
            },
            "evidence_urls": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://"
              }
            },
            "note": {
              "type": "string",
              "minLength": 1
            },
            "file_checks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "url",
                  "read_scope",
                  "result"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https?://"
                  },
                  "read_scope": {
                    "enum": [
                      "first_8_lines",
                      "first_4_lines",
                      "complete_small_csv",
                      "complete_csv",
                      "complete_json",
                      "complete_jsonl",
                      "complete_conllu",
                      "complete_xlsx_sheet",
                      "complete_delimited_table",
                      "complete_xlsx_workbook",
                      "complete_r_serialization",
                      "archive_selected_members",
                      "complete_text",
                      "complete_document_text",
                      "complete_audio_frames",
                      "complete_mat_variables",
                      "bounded_table_prefix",
                      "archive_directory_only"
                    ]
                  },
                  "result": {
                    "type": "string",
                    "minLength": 1
                  },
                  "blob_sha": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{40}$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "checked_on": {
                    "type": "string",
                    "format": "date"
                  },
                  "file_role": {
                    "enum": [
                      "empirical_or_norm_data",
                      "model_generated_auxiliary",
                      "documentation_or_materials",
                      "corpus_derived_data",
                      "model_generated_or_stimulus_materials"
                    ]
                  }
                },
                "anyOf": [
                  {
                    "required": [
                      "blob_sha"
                    ]
                  },
                  {
                    "required": [
                      "sha256"
                    ]
                  }
                ]
              }
            },
            "osf_audit": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "checked_on",
                "status",
                "root_metadata_read",
                "inventory_file_count_lower_bound",
                "inventory_complete_within_bounded_scope",
                "downloaded_file_count",
                "readable_empirical_file_count",
                "report_path"
              ],
              "properties": {
                "checked_on": {
                  "type": "string",
                  "format": "date"
                },
                "status": {
                  "enum": [
                    "empirical_data_readable",
                    "auxiliary_only_readable",
                    "materials_only_readable",
                    "metadata_read_no_data_downloaded",
                    "access_unresolved",
                    "deferred_api_rate_limit",
                    "partial_data_readable",
                    "download_unavailable",
                    "empty_storage_in_checked_scope",
                    "source_gone"
                  ]
                },
                "root_metadata_read": {
                  "type": "boolean"
                },
                "inventory_file_count_lower_bound": {
                  "type": "integer",
                  "minimum": 0
                },
                "inventory_complete_within_bounded_scope": {
                  "type": "boolean"
                },
                "downloaded_file_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "readable_empirical_file_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "report_path": {
                  "type": "string",
                  "pattern": "^catalog/osf-file-audit-[0-9-]+\\.md$"
                }
              }
            }
          }
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "osf_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]{5}$"
          },
          "uniqueItems": true
        },
        "data_status": {
          "enum": [
            "released_data",
            "described_resource",
            "materials_only",
            "discovery_portal"
          ]
        },
        "data_origin": {
          "enum": [
            "human_observations",
            "human_norms",
            "corpus_annotation",
            "synthetic_stimuli",
            "derived_data",
            "mixed_or_unspecified",
            "materials_only",
            "discovery_portal"
          ]
        }
      }
    }
  }
}
